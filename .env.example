# ---------------------------------------------------------------------------
# RAYA configuration
#
# Copy to .env and fill in. Every value has a working default except the
# credentials, which have no safe default: without them RAYA reports the
# corresponding capability as unavailable rather than faking it.
# ---------------------------------------------------------------------------

# --- Reverse image search --------------------------------------------------
# Required for a real run. Get a key at https://serpapi.com.
# With no key, RAYA reports "search unavailable" and never invents candidates.
SEARCH_PROVIDER=serpapi
SERPAPI_KEY=

# Google Lens is given a URL, not an upload, so the input image must be
# publicly reachable. Leave PUBLIC_BASE_URL empty to have RAYA publish the
# input to IPFS and search the gateway URL. Set it only if this API is itself
# reachable from the internet (e.g. behind a tunnel).
PUBLIC_BASE_URL=

# --- IPFS ------------------------------------------------------------------
# auto: use Pinata if a JWT is set, else a local node, else on-disk storage.
# On-disk storage computes a real CIDv1 but publishes nothing, and the run is
# labelled accordingly.
IPFS_PROVIDER=auto
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
KUBO_API_URL=http://127.0.0.1:5001
IPFS_PUBLIC_GATEWAY=https://ipfs.io

# --- Blockchain: Core Testnet2 ---------------------------------------------
CHAIN_RPC_URL=https://rpc.test2.btcs.network
CHAIN_ID=1114
CHAIN_NAME=Core Testnet2
CHAIN_CURRENCY=tCORE2
CHAIN_EXPLORER=https://scan.test2.btcs.network

# Set after running `npm run deploy` in blockchain/.
CONTRACT_ADDRESS=

# Test key only. Fund it at https://scan.test2.btcs.network/faucet.
# Never put a key holding real value here.
DEPLOYER_PRIVATE_KEY=

# --- Verification tuning ---------------------------------------------------
# SFace publishes 0.363 as its cosine operating point; RAYA defaults to 0.40
# for margin against recompressed web images. Raising it trades recall for
# precision. Changing it changes what counts as a match, so it is recorded in
# every evidence bundle.
SIMILARITY_THRESHOLD=0.40
FACE_SCORE_THRESHOLD=0.9
MIN_FACE_SIZE_PX=48
MAX_CANDIDATES=40
MAX_VERIFIED_CANDIDATES=12
